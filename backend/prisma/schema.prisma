// Prisma schema for MEDTEC – Phase 1 (multi‑hospital)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ==================== Core models ====================
model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  role              String   @default("PATIENT") // PATIENT, DOCTOR, PHARMACY, ADMIN, SUPER_ADMIN
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patientInfo       PatientProfile?
  doctorInfo        DoctorProfile?
  pharmacyInfo      PharmacyProfile?
  employeeInfo      EmployeeProfile?
  notifications     Notification[]
  auditLogs         AuditLog[]
  hospitalMemberships HospitalMembership[]
  roomBookings      RoomBooking[]        @relation("BookedBy")
  attendances       Attendance[]         @relation("UserAttendance")
  correctedAttendances Attendance[]       @relation("AttendanceCorrector")
  workSchedules     WorkSchedule[]
}

model PatientProfile {
  id            String         @id @default(uuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  phone         String?
  address       String?
  birthDate     DateTime?
  prescriptions Prescription[]
  appointments  Appointment[]
  orders        Order[]
  consultations Consultation[]
  imagings      MedicalImaging[]
}

model DoctorProfile {
  id             String               @id @default(uuid())
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  specialty      String
  licenseNb      String               @unique
  phone          String?
  prescriptions  Prescription[]
  appointments   Appointment[]
  consultations  Consultation[]
  availabilities DoctorAvailability[]
  roomBookings   RoomBooking[]
}

model PharmacyProfile {
  id        String          @id @default(uuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  address   String
  phone     String?
  inventory InventoryItem[]
  orders    Order[]
}

model Consultation {
  id         String         @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id])
  doctorId   String
  doctor     DoctorProfile  @relation(fields: [doctorId], references: [id])
  date       DateTime       @default(now())
  diagnosis  String
  notes      String?
  vitalSigns String?
  createdAt  DateTime       @default(now())
  hospitalId String?        // nullable tenant reference
  hospital Hospital? @relation("HospitalConsultations", fields: [hospitalId], references: [id])
}

model Prescription {
  id        String             @id @default(uuid())
  patientId String
  patient   PatientProfile     @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    DoctorProfile      @relation(fields: [doctorId], references: [id])
  createdAt DateTime           @default(now())
  notes     String?
  items     PrescriptionItem[]
  hospitalId String?           // nullable tenant reference
  hospital Hospital? @relation("HospitalPrescriptions", fields: [hospitalId], references: [id])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationName String
  dosage         String
  duration       String
  hospitalId     String?      // nullable tenant reference
  hospital Hospital? @relation("HospitalPrescriptionItems", fields: [hospitalId], references: [id])
}


model InventoryItem {
  id         String          @id @default(uuid())
  pharmacyId String
  pharmacy   PharmacyProfile @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  stock       Int     @default(0)
  price       Float

  barcode  String? @unique
  supplier String?

  expiryDate DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orderItems OrderItem[]
  stockMovements StockMovement[]
  hospitalId String?        // nullable tenant reference
  hospital Hospital? @relation("HospitalInventoryItems", fields: [hospitalId], references: [id])
}

model StockMovement {
  id        String        @id @default(uuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Int // can be positive or negative
  type      String // ENTRY, EXIT, DISPENSE, ADJUSTMENT
  reason    String?
  createdAt DateTime      @default(now())
  hospitalId String?      // nullable tenant reference
  hospital Hospital? @relation("HospitalStockMovements", fields: [hospitalId], references: [id])
}

model DoctorAvailability {
  id           String        @id @default(uuid())
  doctorId     String
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 1 = Lundi ... 7 = Dimanche
  startTime    String // "09:00"
  endTime      String // "17:00"
  slotDuration Int           @default(30) // minutes
  isAvailable  Boolean       @default(true)

  hospitalId   String?       // nullable tenant reference
  hospital Hospital? @relation("HospitalDoctorAvailabilities", fields: [hospitalId], references: [id])
}

model Appointment {
  id        String @id @default(uuid())
  patientId String
  doctorId  String

  patient PatientProfile @relation(fields: [patientId], references: [id])
  doctor  DoctorProfile  @relation(fields: [doctorId], references: [id])

  date      DateTime
  status    String   @default("PENDING") // PENDING / CONFIRMED / CANCELLED / COMPLETED
  createdAt DateTime @default(now())
  hospitalId String?       // nullable tenant reference
  hospital   Hospital?     @relation("HospitalAppointments", fields: [hospitalId], references: [id])
}

model Order {
  id         String @id @default(uuid())
  patientId  String
  pharmacyId String

  patient  PatientProfile  @relation(fields: [patientId], references: [id])
  pharmacy PharmacyProfile @relation(fields: [pharmacyId], references: [id])

  status     String   @default("PENDING")
  totalPrice Float
  createdAt  DateTime @default(now())

  items OrderItem[]
  hospitalId String?       // nullable tenant reference
  hospital   Hospital?     @relation("HospitalOrders", fields: [hospitalId], references: [id])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   InventoryItem @relation(fields: [productId], references: [id])

  quantity Int
  hospitalId String?       // nullable tenant reference
  hospital   Hospital?     @relation("HospitalOrderItems", fields: [hospitalId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ALERT
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  hospitalId String?        // nullable tenant reference
  hospital Hospital? @relation("HospitalNotifications", fields: [hospitalId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  hospitalId String?        // nullable tenant reference
  hospital Hospital? @relation("HospitalAuditLogs", fields: [hospitalId], references: [id])
}

// ==================== Multi‑hospital extensions ====================
enum HospitalRole {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  HOSPITAL_MANAGER
  DEPARTMENT_HEAD
  DOCTOR
  SURGEON
  ANESTHESIOLOGIST
  NURSE
  EMERGENCY_STAFF
  PHARMACIST
  RECEPTIONIST
  PATIENT
}

model Hospital {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opposite side of all tenant‑owned relations (nullable, one‑to‑many)
  consultations       Consultation[] @relation("HospitalConsultations")
  prescriptions       Prescription[] @relation("HospitalPrescriptions")
  prescriptionItems   PrescriptionItem[] @relation("HospitalPrescriptionItems")
  inventoryItems      InventoryItem[] @relation("HospitalInventoryItems")
  stockMovements      StockMovement[] @relation("HospitalStockMovements")
  doctorAvailabilities DoctorAvailability[] @relation("HospitalDoctorAvailabilities")
  appointments        Appointment[]         @relation("HospitalAppointments")
  orders              Order[]               @relation("HospitalOrders")
  orderItems          OrderItem[]           @relation("HospitalOrderItems")
  notifications       Notification[]        @relation("HospitalNotifications")
  auditLogs           AuditLog[]            @relation("HospitalAuditLogs")

  rooms               Room[]                @relation("HospitalRooms")
  memberships         HospitalMembership[]
  imagings            MedicalImaging[]      @relation("HospitalMedicalImagings")
}

model Room {
  id          String        @id @default(uuid())
  name        String        @unique
  type        String        @default("CONSULTATION") // CONSULTATION | OPERATING | WARD | EMERGENCY | ICU | LAB | OTHER
  floor       Int?
  capacity    Int?
  status      String        @default("AVAILABLE") // AVAILABLE | MAINTENANCE | CLOSED
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  hospitalId  String?       // nullable tenant reference
  hospital    Hospital?     @relation("HospitalRooms", fields: [hospitalId], references: [id])
  bookings    RoomBooking[]
}

model RoomBooking {
  id             String        @id @default(uuid())
  roomId         String
  room           Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime
  purpose        String
  bookedByUserId String
  bookedByUser   User          @relation("BookedBy", fields: [bookedByUserId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctor         DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  status         String        @default("SCHEDULED") // SCHEDULED | CANCELLED | COMPLETED
  createdAt      DateTime      @default(now())
}

model EmployeeProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String        @unique
  firstName    String
  lastName     String
  jobTitle     String        // NURSE | ANESTHESIOLOGIST | RECEPTIONIST | TECHNICIAN | PHARMACIST_ASSISTANT | SECURITY | CLEANING | ADMIN_STAFF | OTHER
  department   String?
  phone        String?
  hireDate     DateTime?
  status       String        @default("ACTIVE") // ACTIVE | ON_LEAVE | SUSPENDED | TERMINATED
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
}

model Attendance {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  date              String        // jour, format YYYY-MM-DD
  checkInAt         DateTime
  checkOutAt        DateTime?
  source            String        @default("SELF") // SELF | ADMIN
  status            String        @default("PRESENT") // PRESENT | LATE | ABSENT | LEAVE
  note              String?
  correctedByUserId String?
  correctedByUser   User?         @relation("AttendanceCorrector", fields: [correctedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
}

model WorkSchedule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday   Int      // 0 = Dimanche, 1 = Lundi ... 6 = Samedi
  startTime String   // "HH:mm"
  endTime   String   // "HH:mm"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, weekday])
}

model HospitalMembership {
  id         String       @id @default(uuid())
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  hospital   Hospital     @relation(fields: [hospitalId], references: [id])
  hospitalId String
  role       HospitalRole
  isPrimary  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, hospitalId])
}

model MedicalImaging {
  id          String         @id @default(uuid())
  patientId   String
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title       String
  type        String         // XRAY, CT_SCAN, MRI, ULTRASOUND, OTHER
  date        DateTime       @default(now())
  bodyPart    String?
  facility    String?
  notes       String?
  fileUrl     String         // Data URL or file URL
  fileName    String?
  fileType    String?        // image/jpeg, image/png, application/pdf
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  hospitalId  String?        // nullable tenant reference
  hospital    Hospital?      @relation("HospitalMedicalImagings", fields: [hospitalId], references: [id])
}
